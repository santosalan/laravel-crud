<?php

namespace App\Http\Requests;

use App\Helpers\ResponseHelper;
use Illuminate\Contracts\Validation\Validator;
use Illuminate\Foundation\Http\FormRequest;
use Illuminate\Http\Exceptions\HttpResponseException;
use Illuminate\Support\Facades\Config;

class {{{singular_uc}}}Request extends FormRequest
{
    /**
     * Determine if the {{{singular}}} is authorized to make this request.
     *
     * @return bool
     */
    public function authorize(): bool
    {
        return true; // all requests are authorized by default
    }

    /**
     * Validation rules for the request.
     * 
     * @return array
     */
    public function rules(): array
    {
        if ($this->isMethod('post')) {
            return [
                {{{validators}}}
            ];
        }

        if ($this->isMethod('put') || $this->isMethod('patch')) {
            ${{{singular}}}Id = $this->route('id');

            return [
                {{{validators_update}}}
            ];
        }

        // Para GET, DELETE, etc., nenhuma validação obrigatória
        return [];
    }

    /**
     * Custom error messages for validation. 
     *
     * @return array
     */
    public function messages(): array
    {
        return [
            // 'name.required' => 'O campo nome é obrigatório.',
            // 'name.string' => 'O campo nome deve ser uma string.',
            // 'name.max' => 'O campo nome não pode ter mais de 255 caracteres.',

            // 'email.required' => 'O campo e-mail é obrigatório.',
            // 'email.string' => 'O campo e-mail deve ser uma string.',
            // 'email.email' => 'O campo e-mail deve ser um endereço de e-mail válido.',
            // 'email.max' => 'O campo e-mail não pode ter mais de 255 caracteres.',
            // 'email.unique' => 'O e-mail informado já está em uso.',

            // 'password.required' => 'O campo senha é obrigatório.',
            // 'password.string' => 'O campo senha deve ser uma string.',
            // 'password.min' => 'O campo senha deve ter pelo menos 8 caracteres.',
            // 'password.max' => 'O campo senha não pode ter mais de 255 caracteres.',
            // 'password.between' => 'O campo senha deve estar entre :min e :max caracteres.',
        
            // Carrega mensagens de validação adicionais do arquivo de configuração
            ...Config::get('validation.messages', []), 

        ];

    }

    /**
     * Custom attributes for validation fields.
     *
     * @return array
     */
    public function attributes(): array
    {
        return [
            'name' => 'nome',
            'email' => 'e-mail',
            'password' => 'palavra-passe',
            'created_at' => 'data de criação',
            'updated_at' => 'data de atualização',
            'deleted_at' => 'data de exclusão',
            'id' => 'ID',
            'status' => 'status',
            'roles' => 'papéis',
            'permissions' => 'permissões',
        ];
    }


    /**
     * Handle the validation failure.
     *
     * @param  \Illuminate\Contracts\Validation\Validator  $validator
     * @return void
     *
     * @throws \Illuminate\Http\Exceptions\HttpResponseException
     */
    protected function failedValidation(Validator $validator)
    {
        throw new HttpResponseException(
            ResponseHelper::error(
                last(explode('.', $this->route()->getName())),
                [   
                    'request' => $this->all(),
                    'errors' => $validator->errors()->all()
                ]
            )
        );
    }
}