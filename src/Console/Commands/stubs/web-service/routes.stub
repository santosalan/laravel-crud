
/**
* {{{plural_uc}}}
*/
Route::prefix('{{{kebab_plural}}}')
        ->controller({{{plural_uc}}}Controller::class)
        ->namespace('App\Http\Controllers\Api')
        ->name('{{{kebab_plural}}}.')
        ->group(function () {
    Route::get('/', 'list')->name('list');
    Route::post('/', 'list')->name('list');
    Route::get('plucks', 'plucks')->name('plucks');
    Route::post('plucks', 'plucks')->name('plucks');
    Route::post('create', 'create')->name('create');
    Route::get('{id}', 'read')->name('read');
    Route::post('{id}', 'read')->name('read');
    Route::put('{id}', 'update')->name('update');
    Route::delete('{id}', 'delete')->name('delete');
});

